/**
 * Local QA only: an admin and a few fictional accounts in the LOCAL database,
 * so the admin pages can be clicked through on localhost. Refuses any
 * database that is not on localhost. The admin password is read from
 * QA_ADMIN_PASSWORD (generated by the caller, never committed).
 *
 *   DATABASE_URL=<local> QA_ADMIN_PASSWORD=... pnpm tsx tools/db/local-qa-seed.mts
 */
import bcrypt from "bcryptjs";
import { prisma } from "../../src/lib/db";

const url = process.env.DATABASE_URL ?? "";
if (!/localhost|127\.0\.0\.1/.test(url)) {
  console.error("local-qa-seed: refusing a non-local database");
  process.exit(1);
}
const password = process.env.QA_ADMIN_PASSWORD ?? "";
if (password.length < 12) {
  console.error("local-qa-seed: set QA_ADMIN_PASSWORD (12+ characters)");
  process.exit(1);
}

const hash = await bcrypt.hash(password, 10);
const admin = await prisma.user.upsert({
  where: { email: "qa-admin@agental.test" },
  update: { passwordHash: hash, isAdmin: true, accountStatus: "STAFF", emailVerified: new Date(), deletedAt: null },
  create: { email: "qa-admin@agental.test", name: "QA Admin", passwordHash: hash, isAdmin: true, accountStatus: "STAFF", emailVerified: new Date(), kind: "TALENT", locale: "en" },
});
const old = new Date(Date.now() - 20 * 24 * 60 * 60 * 1000);
for (const [n, status] of [["junk1", "UNREVIEWED"], ["junk2", "UNREVIEWED"], ["junk3", "SPAM"], ["tester", "TEST"]] as const) {
  await prisma.user.upsert({
    where: { email: `qa-${n}@agental.test` },
    update: { deletedAt: null, accountStatus: status },
    create: { email: `qa-${n}@agental.test`, name: `QA ${n}`, passwordHash: hash, accountStatus: status, createdAt: old, locale: "en" },
  });
}
console.log("local-qa-seed: ok", admin.id);
await prisma.$disconnect();
