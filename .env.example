# Supabase connection. These two values are PUBLIC by design (the database is
# protected by Row Level Security), so they are safe in the browser and in git.
# Copy this file to .env.local and replace with your own project's values
# (Supabase -> Project Settings -> API Keys). NEVER put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Public URL of this backend.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
