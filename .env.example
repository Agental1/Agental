# Copy to .env and fill in. `bun run db:migrate` and `bun run dev` both need this file.

# --- Required ---------------------------------------------------------------

# PostgreSQL (Supabase) in every environment, local included: a local run that
# exercises a different engine than production proves nothing about production.
# Use the POOLED connection string — Supabase dashboard → Project Settings →
# Database → Connection string → "Transaction pooler" (port 6543). Serverless
# functions open a connection per invocation and exhaust a direct pool.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# The DIRECT connection (port 5432), used only by `prisma migrate`. The
# transaction pooler cannot run the session-level statements DDL needs, so
# migrations fail against DATABASE_URL with a confusing error.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Required in production, optional locally --------------------------------

# Object storage (Cloudflare R2, S3-compatible). All four or none: partial
# configuration is refused rather than silently downgraded to local disk.
# Cloudflare dashboard → R2 → your bucket for the first two, then
# R2 → Manage API tokens → Create token (Object Read & Write) for the keys.
# Without them the app writes to <cwd>/.uploads, which a serverless host wipes
# on every redeploy — fine for local dev, data loss anywhere else.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Sign in with Google / Apple (all optional) ------------------------------
# Each provider appears only when its variables are set. With none, the site
# offers email and password only.

# Set on the Vercel PRODUCTION environment only, never on Preview: a preview
# with this value would build production callback URLs.
# AUTH_URL=https://www.agental.co

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
#   https://www.agental.co/api/auth/callback/google
# Add http://localhost:3000/api/auth/callback/google for local testing.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Developer -> Identifiers -> Services ID (this value is AUTH_APPLE_ID),
# with "Sign in with Apple" enabled and the return URL:
#   https://www.agental.co/api/auth/callback/apple
# Apple accepts https only and no preview hosts, so it cannot run on localhost.
AUTH_APPLE_ID=
# Either paste a client secret JWT (expires after at most 6 months)...
AUTH_APPLE_SECRET=
# ...or leave it empty and give the key, and the app signs one at runtime.
# Keys -> create a key with Sign in with Apple; paste the .p8 contents, with
# newlines kept or written as \n.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# --- Optional ---------------------------------------------------------------

# Canonical origin for metadataBase, sitemap, robots and Open Graph URLs.
# Defaults to https://www.agental.co (the apex 308s to www, so a canonical on
# the apex would point at a redirect). Set it on Vercel previews so a preview
# deployment does not claim production canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Audience measurement. Leave empty to disable entirely (local dev, previews).
# Cookieless, so no consent banner is required. Locale segmentation is free:
# /fr, /en and /es are distinct paths.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Matching scorer: "mock" (default, no API key needed) or "llm".
SCORER=mock

# Required when SCORER=llm — the app refuses to start the LLM scorer without it
# rather than falling back to the mock, which would serve deterministic scores
# as if they were real matching.
# ANTHROPIC_API_KEY=

# --- Limelight (portfolio sites for performers) ------------------------------
# Requests from the Limelight page are stored in the database first
# (POST /api/limelight/interest), then the team is told by email. n8n is not
# part of this path. Details: docs/LIMELIGHT_HANDOFF.md.

# The team inbox that receives one short alert per new request. The alert
# carries a reference only, never the person's details. Empty: requests are
# still stored and listed for admins; alerts wait, and no attempt is used up.
# Sending also needs RESEND_API_KEY and EMAIL_FROM below.
LIMELIGHT_ALERT_EMAIL=

# Bearer token for GET /api/limelight/outbox/drain, which retries alerts that
# did not go out. Generate with: openssl rand -base64 32. Empty: the route
# answers 404.
CRON_SECRET=

# Root domain of hosted portfolio sites, such as agental.site. A published
# site gets <name>.<root>. Empty: publishing records no hostname.
LIMELIGHT_ROOT_DOMAIN=
# CNAME target shown to a customer who brings their own domain. Empty: the
# root domain above.
LIMELIGHT_CNAME_TARGET=
# The app's own hosts, comma-separated (www.agental.co,agental.co). Used to
# tell a customer's domain from ours, and to refuse ours as a custom domain.
LIMELIGHT_APP_HOSTS=

# --- Messages ------------------------------------------------------------------
# The team inbox told when a performer writes to "Agental team": one short
# mail with the thread id, at most every ten minutes per conversation. Empty:
# no mail; messages still show in the admin inbox.
TEAM_INBOX_EMAIL=

# --- Workflow dry run (docs/WORKFLOWS.md) --------------------------------------
# Everything here is off when empty. Nothing in this path sends a message,
# submits an application or contacts a casting platform.

# Secret that signs requests to POST /api/workflow/briefs. Empty: the route
# answers 404.
WORKFLOW_SIGNING_SECRET=
# Extra brief sources allowed besides "manual" and "fixture", comma-separated.
WORKFLOW_ALLOWED_SOURCES=
# Profile ids taking part in the dry run, comma-separated. Empty: briefs are
# stored and nobody is evaluated.
WORKFLOW_PILOT_PROFILE_IDS=
# "true" adds the model step to the rules (needs ANTHROPIC_API_KEY). Empty:
# rules only, no model call, no spend.
WORKFLOW_MODEL_ENABLED=
# Receives one mail when a run is given up on (run id only).
WORKFLOW_ALERT_EMAIL=
# Limits have safe defaults and hard ceilings in src/domain/workflow/limits.ts:
# WORKFLOW_MAX_BRIEFS_PER_REQUEST, WORKFLOW_MAX_PROFILES_PER_RUN,
# WORKFLOW_MAX_MODEL_CALLS_PER_RUN, WORKFLOW_MAX_RETRIES_PER_ITEM,
# WORKFLOW_MODEL_TIMEOUT_MS, WORKFLOW_MAX_COST_PER_RUN_MICROUSD,
# WORKFLOW_MAX_COST_PER_DAY_MICROUSD, WORKFLOW_MAX_RUN_ATTEMPTS,
# WORKFLOW_MAX_REQUESTS_PER_HOUR.

# --- Local tests ---------------------------------------------------------------
# The local `prisma dev` database answers one query at a time. Set this to 1
# when running database-backed tests against it, and run them with
# `vitest run --no-file-parallelism`. Leave empty everywhere else.
# DATABASE_POOL_MAX=1

# --- Email (verification and password reset) ---------------------------------
# Confirmation links at sign-up and password reset links, sent through Resend.
# Setup, step by step: docs/EMAIL_SETUP.md.

# Resend dashboard -> API Keys -> Create API Key ("Sending access" is enough).
# Empty: emails are logged on the server instead of sent, one line each, with
# the link shown outside production only. Local development needs no account.
RESEND_API_KEY=

# The sender, on a domain verified in Resend (Domains -> Add Domain). Example:
#   EMAIL_FROM="Agental <no-reply@agental.co>"
# Empty: same as an empty key, since sending needs both.
EMAIL_FROM=

# The day from which a new password account must confirm its address before
# going further. You choose it: an ISO date (2026-12-01, midnight UTC) or an
# instant with its zone (2026-12-01T08:00:00+01:00). Accounts created earlier
# are left alone. Empty or unreadable: confirmation stays optional for everyone.
EMAIL_VERIFICATION_REQUIRED_SINCE=
